{
  "name": "syrius-extension",
  "version": "0.3.4",
  "description": "Syrius extension provides a non-custodial wallet solution for Zenon - Network of Momentum that can run in the browser.",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MichZNN/syrius-extension"
  },
  "scripts": {
    "build": "node utils/build.js",
    "dev:build": "node utils/dev-harness.js build",
    "dev:start": "node utils/dev-harness.js start",
    "dev:shot": "node utils/dev-harness.js shot",
    "dev:reload": "node utils/dev-harness.js reload",
    "dev:stop": "node utils/dev-harness.js stop",
    "prettier": "prettier --write '**/*.{js,jsx,ts,tsx,json,css,scss,md}'",
    "lint": "eslint src/**/*.js src/**/*.jsx",
    "test": "node utils/contract-calls-test.js",
    "test:security": "node utils/bigint-buffer-test.js && node utils/token-metadata-test.js && node utils/password-policy-test.js && node utils/live-vault-test.js && node utils/session-policy-test.js && node utils/wallet-deletion-test.js && node utils/request-identity-test.js && node utils/approval-queue-test.js && node utils/approval-operation-test.js && node utils/wallet-scoping-test.js && node utils/block-approval-test.js && node utils/contract-arguments-test.js && node utils/provider-state-test.js && node utils/document-binding-test.js"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^1.8.1",
    "babel-preset-react": "^6.24.1",
    "base64-loader": "^1.0.0",
    "bigint-buffer": "file:vendor/bigint-buffer",
    "buffer": "^6.0.3",
    "cipher-base": "^1.0.4",
    "crypto-browserify": "^3.12.0",
    "ethers": "^5.7.2",
    "js-sha3": "^0.13.0",
    "node-polyfill-webpack-plugin": "^1.1.4",
    "path": "^0.12.7",
    "path-browserify": "^1.0.1",
    "raw-loader": "^4.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.31.2",
    "react-qr-code": "^2.0.7",
    "react-redux": "^8.0.1",
    "react-router-dom": "^7.18.3",
    "react-toastify": "^9.0.1",
    "readable-stream": "^3.6.0",
    "sass": "^1.50.1",
    "stream-browserify": "^3.0.0",
    "url-loader": "^4.1.1",
    "znn-ts-sdk": "https://codeload.github.com/DexterLabZ/znn.ts/tar.gz/63c4cad42fd08604f9a2e74f68418dccc1cb4f86"
  },
  "devDependencies": {
    "@babel/core": "^7.17.0",
    "@babel/eslint-parser": "^7.28.0",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/preset-env": "^7.16.11",
    "@babel/preset-react": "^7.16.7",
    "@babel/preset-stage-2": "^7.8.3",
    "@types/chrome": "^0.0.177",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "babel-loader": "^8.2.3",
    "babel-preset-react-app": "^10.0.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.6.0",
    "eslint": "^8.8.0",
    "eslint-config-react-app": "^7.0.0",
    "eslint-plugin-flowtype": "^8.0.3",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-react": "^7.28.0",
    "eslint-plugin-react-hooks": "^4.3.0",
    "file-loader": "^6.2.0",
    "fs-extra": "^10.0.0",
    "html-loader": "^3.1.0",
    "html-webpack-plugin": "^5.5.0",
    "lru-cache": "^11.1.0",
    "prettier": "^2.5.1",
    "sass-loader": "^12.4.0",
    "source-map-loader": "^3.0.1",
    "style-loader": "^3.3.1",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.2.6",
    "typescript": "^4.5.5",
    "vm-browserify": "^1.1.2",
    "webpack": "^5.68.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^4.9.2"
  },
  "browser": {
    "stream": true,
    "buffer": false,
    "node:worker_threads": false,
    "node:url": false,
    "crypto": false
  },
  "browserslist": {
    "production": [
      "chrome >= 88"
    ]
  },
  "overrides": {
    "inflight": "npm:@npmcli/promise-spawn@^7.0.0",
    "rimraf": "^5.0.0",
    "glob": "^9.3.5",
    "@humanwhocodes/config-array": "npm:@eslint/config-array@^0.18.0",
    "@humanwhocodes/object-schema": "npm:@eslint/object-schema@^2.1.4",
    "argon2": "^0.45.1",
    "qs": "^6.16.0",
    "@ethersproject/providers": {
      "ws": "^8.21.3"
    }
  }
}
